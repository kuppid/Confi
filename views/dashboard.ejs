<%- include('header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0"><%= title %></h1>
  <a class="btn btn-primary" href="/create">Новая заявка</a>
</div>
<% if (requests.length) { %>
  <div class="table-responsive card"><table class="table table-hover align-middle mb-0">
    <thead><tr><th>Помещение</th><th>Дата</th><th>Оплата</th><th>Статус</th></tr></thead>
    <tbody>
    <% requests.forEach(function (r) { %>
      <tr>
        <td><%= r.room_name %></td>
        <td><%= fmtDate(r.date_start) %></td>
        <td><%= r.payment %></td>
        <td><%= r.status %></td>
      </tr>
    <% }); %>
    </tbody>
  </table></div>
<% } else { %>
  <div class="alert alert-info">Заявок пока нет.</div>
<% } %>
<%- include('footer') %>
